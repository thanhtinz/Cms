// Nen tang cho thue website — web chinh (platform)
// Database: PostgreSQL (Neon tren Vercel). DATABASE_URL lay tu bien moi truong.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  role         String        @default("CUSTOMER") // ADMIN | CUSTOMER
  sessions     Session[]
  orders       RentalOrder[]
  sites        Site[]
  createdAt    DateTime      @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Template {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  category    String
  description String
  coverImage  String?
  gallery     String        @default("") // moi URL 1 dong
  features    String        @default("") // moi tinh nang 1 dong
  demoUrl     String?
  folderSlug  String? // thu muc src trong sites/ tuong ung, vd: sites/shop-thoi-trang
  premium     Boolean       @default(false)
  minPlanTier Int           @default(1) // tier goi toi thieu de dung mau nay
  status      String        @default("PUBLISHED") // DRAFT | PUBLISHED
  sort        Int           @default(0)
  orders      RentalOrder[]
  sites       Site[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Plan {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  tier         Int           @unique // 1,2,3,4... de so voi minPlanTier cua mau
  priceMonth   Int // VND
  storageGb    Int
  bandwidthGb  Int // -1 = khong gioi han hop ly
  pagesLimit   Int // -1 = khong gioi han
  productsLimit Int // -1 = khong gioi han
  cmsUsers     Int
  domains      Int           @default(1)
  features     String        @default("") // moi dong 1 tinh nang
  excluded     String        @default("") // moi dong 1 tinh nang KHONG co
  ecommerce    Boolean       @default(false)
  highlight    Boolean       @default(false)
  active       Boolean       @default(true)
  sort         Int           @default(0)
  orders       RentalOrder[]
  sites        Site[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Goi thoi gian: khach chon 1 goi duy nhat — da gom so thang + tong gia tron goi.
// (Thay cho mo hinh cu: chon Plan theo thang x DurationOption chiet khau.)
model TimePackage {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  months        Int // so thang su dung cua goi
  price         Int // VND — tong gia tron goi (khong phai gia/thang)
  compareAt     Int           @default(0) // gia goc gach ngang de so sanh, 0 = khong hien
  tier          Int           @default(1) // cap dich vu — so voi minPlanTier cua mau
  storageGb     Int           @default(5)
  bandwidthGb   Int           @default(100) // -1 = khong gioi han hop ly
  pagesLimit    Int           @default(-1)
  productsLimit Int           @default(-1)
  cmsUsers      Int           @default(2)
  ecommerce     Boolean       @default(false)
  features      String        @default("") // moi dong 1 tinh nang
  highlight     Boolean       @default(false)
  active        Boolean       @default(true)
  sort          Int           @default(0)
  orders        RentalOrder[]
  sites         Site[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DurationOption {
  id              String  @id @default(cuid())
  months          Int     @unique
  discountPercent Int     @default(0)
  label           String?
  active          Boolean @default(true)
  sort            Int     @default(0)
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  sort     Int     @default(0)
  active   Boolean @default(true)
}

model RentalOrder {
  id              String    @id @default(cuid())
  code            String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  templateId      String
  template        Template  @relation(fields: [templateId], references: [id])
  planId          String?
  plan            Plan?       @relation(fields: [planId], references: [id])
  timePackageId   String?
  timePackage     TimePackage? @relation(fields: [timePackageId], references: [id])
  planName        String // snapshot luc dat (ten goi thoi gian voi don moi)
  planPriceMonth  Int // snapshot (don moi: gia goi quy doi/thang lam tron)
  durationMonths  Int
  discountPercent Int       @default(0) // chiet khau theo thoi han
  subtotal        Int       @default(0) // VND sau chiet khau thoi han, truoc voucher
  voucherId       String?
  voucher         Voucher?  @relation(fields: [voucherId], references: [id])
  voucherCode     String? // snapshot ma voucher luc dat
  voucherDiscount Int       @default(0) // VND duoc giam tu voucher
  total           Int // VND phai tra cuoi cung
  siteName        String
  domain          String
  status          String    @default("CHO_THANH_TOAN") // CHO_THANH_TOAN | DA_THANH_TOAN | DA_HUY
  note            String?
  site            Site?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Voucher {
  id          String        @id @default(cuid())
  code        String        @unique
  description String        @default("")
  type        String        @default("PERCENT") // PERCENT: giam % | FIXED: giam thang VND
  value       Int // PERCENT: 1-100 | FIXED: so VND
  maxDiscount Int           @default(0) // PERCENT: tran giam VND, 0 = khong tran
  minTotal    Int           @default(0) // don (sau chiet khau thoi han) toi thieu de dung
  usageLimit  Int           @default(0) // 0 = khong gioi han luot dung
  usedCount   Int           @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean       @default(true)
  orders      RentalOrder[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model NewsPost {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String   @default("")
  content    String   @default("") // cac doan van cach nhau bang 1 dong trong
  coverImage String?
  category   String   @default("Tin tức")
  published  Boolean  @default(true)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Site {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  orderId    String      @unique
  order      RentalOrder @relation(fields: [orderId], references: [id])
  templateId String
  template   Template    @relation(fields: [templateId], references: [id])
  planId     String?
  plan       Plan?       @relation(fields: [planId], references: [id])
  timePackageId String?
  timePackage   TimePackage? @relation(fields: [timePackageId], references: [id])
  name       String
  slug       String      @unique // ten mien tam: {slug}.{platformDomain}
  domain     String
  dnsToken   String
  status     String      @default("CHO_TRO_DNS") // CHO_TRO_DNS | DANG_HOAT_DONG | TAM_NGUNG | HET_HAN
  startedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Setting {
  id             String @id @default("main")
  brandName      String @default("ThuêWeb")
  logoUrl        String?
  heroTitle      String @default("Thuê website theo mẫu — có web riêng trong vài phút")
  heroSubtitle   String @default("Chọn mẫu, chọn gói, nhập tên miền của bạn. Hệ thống tự tạo website, bạn chỉ việc trỏ tên miền về Cloudflare theo hướng dẫn.")
  heroCtaText    String @default("Xem kho mẫu")
  supportEmail   String @default("hotro@example.com")
  supportPhone   String @default("")
  zaloUrl        String?
  platformDomain String @default("thueweb.vn") // ten mien chinh cua nen tang: ten mien tam = {slug}.{platformDomain}
  cnameTarget    String @default("connect.thueweb.vn") // gia tri CNAME khach tro ve
  acmeTarget     String @default("acme.thueweb.vn") // gia tri CNAME _acme-challenge (delegated DCV)
  bankCode       String @default("") // vd MB, VCB, TCB — dung de tao VietQR
  bankAccount    String @default("")
  bankOwner      String @default("")
  trialDays      Int    @default(7)
  graceDays      Int    @default(7)
  archiveDays    Int    @default(30)
  footerText     String @default("")
  updatedAt      DateTime @updatedAt
}
